# LLM local (Ollama)
LLM_MODEL=mistral:7b
LLM_TIMEOUT=180
GOVIA_USE_LLM=1

# Comparaison du rapport : autorise la version A sans gouvernance. À laisser à 0 en démonstration publique.
GOVIA_ALLOW_VERSION_A=0

# Lancement sans Docker : copiez ce fichier en .env (ignoré par git), le backend le lit au démarrage.
# LLM cloud (Groq) : transfert à l'étranger soumis à autorisation préalable (Loi n° 2024/017, art. 32).
# À n'activer qu'avec des données synthétiques.
GOVIA_ALLOW_CLOUD_LLM=0
GROQ_API_KEY=
# Modèle Groq (facultatif) et délai court conseillé avec le cloud, par exemple LLM_TIMEOUT=20.
# GROQ_MODEL=openai/gpt-oss-120b
